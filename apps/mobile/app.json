{
  "expo": {
    "name": "NationX Partner",
    "slug": "nationx-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F766E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E"
      },
      "package": "com.nationx.partner"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}

