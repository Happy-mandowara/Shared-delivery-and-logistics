# NationX Production Environment Configuration

# 1. Authoritative Supabase / PostgreSQL Connection
# For Vercel Serverless Functions, use transaction pooler (port 6543) or direct session pooler (port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"

# 2. Cryptographic Session Secret
# Generate with: openssl rand -base64 32
JWT_SECRET="nationx-production-hmac-sha256-secret-key-replace-in-production"

# 3. Environment Flags
NODE_ENV="production"
ALLOW_TEST_UUID_AUTH="false"
NEXT_PUBLIC_ENABLE_DEMO_MODE="false"

# 4. Regional Coordinate Anchors (Default: Khammam, Telangana)
NEXT_PUBLIC_REGION_NAME="Khammam, Telangana"
NEXT_PUBLIC_DEFAULT_LAT="17.2472"
NEXT_PUBLIC_DEFAULT_LNG="80.1514"
